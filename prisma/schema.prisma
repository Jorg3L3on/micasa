// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum PaymentMethodType {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  DEPARTMENT_STORE_CARD
  GOAL
}

enum FortnightPeriod {
  FIRST // 1–15
  SECOND // 16–end of month
}

enum HouseRole {
  OWNER
  ADMIN
  MEMBER
}

enum TransferType {
  USER_TO_HOUSE
}

enum BudgetFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  CUSTOM
}

enum LoanType {
  PERSONAL
  PAYROLL
}

enum LoanPaymentFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum LoanPaymentSource {
  WALLET
  PAYROLL_DEDUCTION
}

enum LoanStatus {
  ACTIVE
  PAID_OFF
  PAUSED
  CANCELLED
}

enum LoanPaymentStatus {
  SCHEDULED
  PAID
  SKIPPED
  CANCELLED
}

enum StatementImportProvider {
  MERCADO_PAGO
  CA_DEPARTAMENTAL
  CA_EFECTIVO
  DIDI_CARD
  LIVERPOOL
}

model User {
  id                   Int     @id @default(autoincrement())
  name                 String
  email                String  @unique
  password             String
  active               Boolean @default(true)
  onboarding_completed Boolean @default(false)
  /// Platform admin (MiCasa support). Distinct from HouseRole.ADMIN.
  is_admin             Boolean @default(false)

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Personal finance
  fortnights         Fortnight[]
  incomes            Income[]
  expenses           Expense[]
  expenseTemplates   ExpenseTemplate[]
  incomeTemplates    IncomeTemplate[]
  wallets            Wallet[]
  categories         Category[]
  creditCardPayments            CreditCardPayment[]
  creditCardScheduledPayments   CreditCardScheduledPayment[]
  creditCardInstallmentPlans    CreditCardInstallmentPlan[]
  budgets                       Budget[]
  loans              Loan[]
  walletTransfers    WalletTransfer[]

  credit_card_statement_imports_created CreditCardStatementImport[] @relation("CreditCardStatementImportCreatedBy")
  credit_card_statement_imports_owned   CreditCardStatementImport[] @relation("CreditCardStatementImportUserOwner")

  wallets_assigned              Wallet[]                     @relation("WalletAssignee")

  admin_audit_logs_as_actor  AdminAuditLog[] @relation("AdminAuditActor")
  admin_audit_logs_as_target AdminAuditLog[] @relation("AdminAuditTarget")

  // Shared
  memberships HouseMember[]
  ownedHouses House[]
  transfers   Transfer[]
}

/**
 * Append-only audit trail for platform-admin mutations (e.g. password override).
 * Never store plaintext secrets in metadata.
 */
model AdminAuditLog {
  id             Int      @id @default(autoincrement())
  actor_user_id  Int
  target_user_id Int?
  action         String
  metadata       Json?
  created_at     DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  actor  User  @relation("AdminAuditActor", fields: [actor_user_id], references: [id])
  target User? @relation("AdminAuditTarget", fields: [target_user_id], references: [id])

  @@index([actor_user_id, created_at])
  @@index([target_user_id, created_at])
  @@index([action, created_at])
}

model Fortnight {
  id         Int             @id @default(autoincrement())
  start_date DateTime
  end_date   DateTime
  label      String
  month      Int
  year       Int
  period     FortnightPeriod
  closed     Boolean         @default(false)

  user_id  Int?
  house_id Int?

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Relationships
  house House? @relation(fields: [house_id], references: [id])
  user  User?  @relation(fields: [user_id], references: [id])

  expenses                  Expense[]
  incomes                   Income[]
  credit_card_payment_plans CreditCardPaymentPlan[]

  @@unique([user_id, month, year, period])
  @@unique([house_id, month, year, period])
  @@index([user_id])
  @@index([house_id])
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  icon        String?
  active      Boolean @default(true)
  sort_order  Int     @default(0)
  parent_id   Int?

  user_id  Int?
  house_id Int?

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Relationships
  user               User?              @relation(fields: [user_id], references: [id])
  house              House?             @relation(fields: [house_id], references: [id])
  parent             Category?          @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Restrict)
  children           Category[]         @relation("CategoryHierarchy")
  expenses           Expense[]
  expense_templates  ExpenseTemplate[]
  budget_allocations BudgetAllocation[]

  @@index([user_id])
  @@index([house_id])
  @@index([parent_id])
  @@index([user_id, parent_id])
  @@index([house_id, parent_id])
}

model ExpenseTemplate {
  id                       Int      @id @default(autoincrement())
  name                     String
  suggested_amount         Decimal? @db.Decimal(10, 2)
  is_recurring             Boolean  @default(false)
  applies_first_fortnight  Boolean  @default(false)
  applies_second_fortnight Boolean  @default(false)
  is_subscription          Boolean  @default(false)
  due_day                  Int?
  due_day_first_fortnight  Int?
  due_day_second_fortnight Int?
  cutoff_day               Int?
  active                   Boolean  @default(true)

  category_id Int?
  house_id    Int?
  user_id     Int?
  wallet_id   Int?

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Relationships
  expenses Expense[]
  category Category? @relation(fields: [category_id], references: [id])
  house    House?    @relation(fields: [house_id], references: [id])
  user     User?     @relation(fields: [user_id], references: [id])
  wallet   Wallet?   @relation(fields: [wallet_id], references: [id])

  @@index([user_id])
  @@index([house_id])
}

model Expense {
  id           Int       @id @default(autoincrement())
  description  String
  amount       Decimal   @db.Decimal(10, 2)
  is_paid      Boolean   @default(false)
  payment_date DateTime?
  due_day      Int?

  /// Cuotas en meses (installment): cuota actual y total (ej. 11 de 15). Null = no aplica.
  credit_installment_current Int?
  credit_installment_total   Int?

  house_id            Int?
  fortnight_id        Int
  category_id         Int?
  expense_template_id Int?
  loan_payment_id     Int? @unique
  user_id             Int?
  wallet_id           Int?

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Relationships
  fortnight        Fortnight        @relation(fields: [fortnight_id], references: [id])
  user             User?            @relation(fields: [user_id], references: [id])
  wallet           Wallet?          @relation(fields: [wallet_id], references: [id])
  category         Category?        @relation(fields: [category_id], references: [id])
  expense_template ExpenseTemplate? @relation(fields: [expense_template_id], references: [id])
  loan_payment     LoanPayment?     @relation("LoanPaymentExpense", fields: [loan_payment_id], references: [id], onDelete: SetNull)
  house            House?           @relation(fields: [house_id], references: [id])

  statement_import_id Int?
  statement_import    CreditCardStatementImport? @relation(fields: [statement_import_id], references: [id], onDelete: SetNull)

  transferAsUser      Transfer?          @relation("TransferUserExpense")
  credit_card_payment CreditCardPayment?

  @@index([user_id])
  @@index([house_id])
  @@index([fortnight_id])
  @@index([wallet_id])
  @@index([expense_template_id])
  @@index([loan_payment_id])
  @@index([statement_import_id])
}

model Income {
  id          Int      @id @default(autoincrement())
  amount      Decimal  @db.Decimal(10, 2)
  source      String?
  received_at DateTime

  user_id            Int?
  house_id           Int?
  fortnight_id       Int
  income_template_id Int?
  wallet_id          Int?
  created_at         DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Relationships
  fortnight       Fortnight       @relation(fields: [fortnight_id], references: [id])
  user            User?           @relation(fields: [user_id], references: [id])
  income_template IncomeTemplate? @relation(fields: [income_template_id], references: [id])
  house           House?          @relation(fields: [house_id], references: [id])
  wallet          Wallet?         @relation(fields: [wallet_id], references: [id])

  transferAsHouse Transfer? @relation("TransferHouseIncome")

  @@index([user_id])
  @@index([house_id])
  @@index([fortnight_id])
  @@index([wallet_id])
}

model IncomeTemplate {
  id                       Int      @id @default(autoincrement())
  name                     String
  suggested_amount         Decimal? @db.Decimal(10, 2)
  source                   String?
  applies_first_fortnight  Boolean  @default(false)
  applies_second_fortnight Boolean  @default(false)
  active                   Boolean  @default(true)

  user_id  Int?
  house_id Int?

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Relationships
  incomes       Income[]
  payroll_loans Loan[]   @relation("LoanIncomeTemplate")
  user          User?    @relation(fields: [user_id], references: [id])
  house         House?   @relation(fields: [house_id], references: [id])

  @@index([user_id])
  @@index([house_id])
}

model House {
  id       Int    @id @default(autoincrement())
  name     String
  owner_id Int?

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Relationships
  owner            User?             @relation(fields: [owner_id], references: [id])
  members          HouseMember[]
  fortnights       Fortnight[]
  expenses         Expense[]
  expenseTemplates ExpenseTemplate[]
  wallets          Wallet[]
  transfersIn      Transfer[]
  incomes          Income[]
  incomeTemplates  IncomeTemplate[]
  categories       Category[]
  loans            Loan[]

  creditCardPayments            CreditCardPayment[]
  creditCardScheduledPayments   CreditCardScheduledPayment[]
  creditCardInstallmentPlans    CreditCardInstallmentPlan[]
  budgets                       Budget[]
  credit_card_statement_imports CreditCardStatementImport[] @relation("CreditCardStatementImportHouseOwner")
  walletTransfers               WalletTransfer[]
}

model HouseMember {
  id       Int       @id @default(autoincrement())
  house_id Int
  user_id  Int
  role     HouseRole @default(MEMBER)

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Relationships
  house House @relation(fields: [house_id], references: [id])
  user  User  @relation(fields: [user_id], references: [id])
}

model Wallet {
  id                           Int               @id @default(autoincrement())
  name                         String
  description                  String?
  provider_icon_key            String?
  amount                       Decimal           @default(0) @db.Decimal(10, 2)
  credit_limit                 Decimal?          @db.Decimal(10, 2)
  /// DiDi Card y similares: límite promocional/temporal mayor que la línea contractual (último valor conocido).
  temporary_credit_limit       Decimal?          @db.Decimal(10, 2)
  /// Fecha de corte del estado de cuenta donde se detectó `temporary_credit_limit` (opcional).
  temporary_credit_limit_as_of DateTime?
  type                         PaymentMethodType
  cutoff_day                   Int?
  due_day                      Int?
  active                       Boolean           @default(true)
  /// Si false, se excluye del saldo de liquidez (efectivo + débito). Solo aplica a CASH/DEBIT_CARD.
  include_in_liquidity         Boolean           @default(true)
  last_paid_period             String?

  /// Meta (GOAL): monto objetivo a alcanzar.
  goal_amount                  Decimal?          @db.Decimal(10, 2)
  /// Meta (GOAL): fecha límite (día civil).
  goal_due_date                DateTime?

  user_id  Int?
  house_id Int?

  /// En contexto casa: miembro al que se atribuye la billetera (opcional; null = compartida).
  assignee_user_id Int?

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Relationships
  user     User?  @relation(fields: [user_id], references: [id])
  house    House? @relation(fields: [house_id], references: [id])
  assignee User?  @relation("WalletAssignee", fields: [assignee_user_id], references: [id])

  expenses                      Expense[]
  expense_templates             ExpenseTemplate[]
  incomes                       Income[]
  credit_card_payments          CreditCardPayment[]         @relation("CreditCardWalletPayments")
  source_card_payments          CreditCardPayment[]         @relation("CreditCardSourceWalletPayments")
  loan_payments_source          Loan[]                      @relation("LoanPaymentSourceWallet")
  linked_loans                  Loan[]                      @relation("LoanLinkedWallet")
  loan_payment_records          LoanPayment[]               @relation("LoanPaymentSourceWallet")
  credit_card_statement_imports CreditCardStatementImport[]
  credit_card_payment_plans     CreditCardPaymentPlan[]
  credit_card_scheduled_payments CreditCardScheduledPayment[]
  credit_card_installment_plans  CreditCardInstallmentPlan[]
  budgetAllocations             BudgetAllocation[]
  wallet_transfers_from         WalletTransfer[]            @relation("WalletTransferFrom")
  wallet_transfers_to           WalletTransfer[]            @relation("WalletTransferTo")

  @@index([user_id])
  @@index([house_id])
  @@index([user_id, type, active])
  @@index([house_id, type, active])
  @@index([house_id, assignee_user_id])
}

/// Monto que planeas pagar a una TC en una quincena (independiente de la deuda total).
model CreditCardPaymentPlan {
  id                    Int      @id @default(autoincrement())
  credit_card_wallet_id Int
  fortnight_id          Int
  planned_amount        Decimal  @db.Decimal(12, 2)
  user_id               Int?
  house_id              Int?
  created_at            DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)
  updated_at            DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  credit_card_wallet Wallet    @relation(fields: [credit_card_wallet_id], references: [id], onDelete: Cascade)
  fortnight          Fortnight @relation(fields: [fortnight_id], references: [id], onDelete: Cascade)

  @@unique([credit_card_wallet_id, fortnight_id])
  @@index([fortnight_id])
  @@index([credit_card_wallet_id])
  @@index([user_id])
  @@index([house_id])
}

enum CreditCardScheduledPaymentStatus {
  SCHEDULED
  PAID
}

/// Calendario de pagos futuros en tarjeta (MSI / mensualidades) sin crear compra ni mover deuda.
model CreditCardScheduledPayment {
  id                     Int                              @id @default(autoincrement())
  credit_card_wallet_id  Int
  due_date               DateTime
  amount                 Decimal                          @db.Decimal(10, 2)
  label                  String?
  status                 CreditCardScheduledPaymentStatus @default(SCHEDULED)
  paid_at                DateTime?
  credit_card_payment_id Int?                             @unique
  user_id                Int?
  house_id               Int?
  created_at             DateTime                         @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)
  updated_at             DateTime                         @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  credit_card_wallet Wallet             @relation(fields: [credit_card_wallet_id], references: [id], onDelete: Cascade)
  credit_card_payment CreditCardPayment? @relation(fields: [credit_card_payment_id], references: [id], onDelete: SetNull)
  user               User?              @relation(fields: [user_id], references: [id])
  house              House?             @relation(fields: [house_id], references: [id])

  @@index([credit_card_wallet_id, due_date])
  @@index([credit_card_wallet_id, status])
  @@index([user_id])
  @@index([house_id])
}

enum CreditCardInstallmentPlanStatus {
  ACTIVE
  COMPLETED
}

enum CreditCardInstallmentPlanPaymentStatus {
  SCHEDULED
  PAID
}

/// Plan de compra a meses en tarjeta (nombre, progreso X de Y, cuotas generadas).
model CreditCardInstallmentPlan {
  id                      Int                             @id @default(autoincrement())
  credit_card_wallet_id   Int
  name                    String
  installment_amount      Decimal                         @db.Decimal(10, 2)
  total_installments      Int
  /// Cuotas ya pagadas al dar de alta (0…N-1). La siguiente es paid_installments + 1.
  paid_installments       Int                             @default(0)
  /// Si true, el saldo de la tarjeta ya incluye la compra (alta tardía).
  already_in_card_balance Boolean                         @default(false)
  status                  CreditCardInstallmentPlanStatus @default(ACTIVE)
  user_id                 Int?
  house_id                Int?
  created_at              DateTime                        @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)
  updated_at              DateTime                        @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  credit_card_wallet Wallet                             @relation(fields: [credit_card_wallet_id], references: [id], onDelete: Cascade)
  user               User?                              @relation(fields: [user_id], references: [id])
  house              House?                             @relation(fields: [house_id], references: [id])
  payments           CreditCardInstallmentPlanPayment[]

  @@index([credit_card_wallet_id, status])
  @@index([user_id])
  @@index([house_id])
}

model CreditCardInstallmentPlanPayment {
  id                     Int                                    @id @default(autoincrement())
  plan_id                Int
  sequence               Int
  due_date               DateTime
  amount                 Decimal                                @db.Decimal(10, 2)
  status                 CreditCardInstallmentPlanPaymentStatus @default(SCHEDULED)
  paid_at                DateTime?
  credit_card_payment_id Int?                                   @unique
  created_at             DateTime                               @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)
  updated_at             DateTime                               @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  plan                CreditCardInstallmentPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  credit_card_payment CreditCardPayment?        @relation(fields: [credit_card_payment_id], references: [id], onDelete: SetNull)

  @@unique([plan_id, sequence])
  @@index([plan_id])
  @@index([due_date])
  @@index([status])
}

model Budget {
  id           Int             @id @default(autoincrement())
  name         String          @db.VarChar(25)
  total_amount Decimal         @db.Decimal(10, 2)
  frequency    BudgetFrequency
  start_date   DateTime?
  end_date     DateTime?
  active       Boolean         @default(true)
  recurrent    Boolean         @default(true)

  user_id  Int?
  house_id Int?

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Relationships
  user        User?              @relation(fields: [user_id], references: [id])
  house       House?             @relation(fields: [house_id], references: [id])
  allocations BudgetAllocation[]
  periods     BudgetPeriod[]

  @@index([user_id])
  @@index([house_id])
}

model BudgetPeriod {
  id         Int      @id @default(autoincrement())
  budget_id  Int
  start_date DateTime
  end_date   DateTime

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  budget   Budget                @relation(fields: [budget_id], references: [id], onDelete: Cascade)
  snapshot BudgetPeriodSnapshot?

  @@index([budget_id])
  @@index([start_date, end_date])
}

model BudgetPeriodSnapshot {
  id           Int      @id @default(autoincrement())
  budget_period_id Int  @unique
  budget_name  String   @db.VarChar(25)
  total_amount Decimal  @db.Decimal(10, 2)
  created_at   DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  budget_period BudgetPeriod                    @relation(fields: [budget_period_id], references: [id], onDelete: Cascade)
  allocations   BudgetPeriodSnapshotAllocation[]
}

model BudgetPeriodSnapshotAllocation {
  id                Int     @id @default(autoincrement())
  snapshot_id       Int
  wallet_id         Int
  wallet_name       String  @db.VarChar(100)
  category_id       Int
  category_name     String  @db.VarChar(100)
  category_icon     String?
  allocated_amount  Decimal @db.Decimal(10, 2)
  created_at        DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  snapshot BudgetPeriodSnapshot @relation(fields: [snapshot_id], references: [id], onDelete: Cascade)

  @@index([snapshot_id])
  @@index([wallet_id])
  @@index([category_id])
}

model BudgetAllocation {
  id          Int     @id @default(autoincrement())
  budget_id   Int
  wallet_id   Int
  category_id Int
  amount      Decimal @db.Decimal(10, 2)

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Relationships
  budget   Budget   @relation(fields: [budget_id], references: [id], onDelete: Cascade)
  wallet   Wallet   @relation(fields: [wallet_id], references: [id])
  category Category @relation(fields: [category_id], references: [id])

  @@index([budget_id])
  @@index([wallet_id])
  @@index([category_id])
}

/**
 * =========================
 * TRANSFERS
 * =========================
 */

model Transfer {
  id       Int          @id @default(autoincrement())
  amount   Decimal      @db.Decimal(10, 2)
  type     TransferType
  user_id  Int
  house_id Int
  note     String?

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  // Optional links to accounting entries created from this transfer
  user_expense_id Int? @unique
  house_income_id Int? @unique

  user_expense Expense? @relation("TransferUserExpense", fields: [user_expense_id], references: [id])
  house_income Income?  @relation("TransferHouseIncome", fields: [house_income_id], references: [id])

  user  User  @relation(fields: [user_id], references: [id])
  house House @relation(fields: [house_id], references: [id])

  @@index([user_id])
  @@index([house_id])
  @@index([created_at])
}

/// Same-owner wallet↔wallet reallocation (CASH/DEBIT). No Expense/Income rows.
model WalletTransfer {
  id                   Int      @id @default(autoincrement())
  amount               Decimal  @db.Decimal(10, 2)
  fee_amount           Decimal  @default(0) @db.Decimal(10, 2)
  from_wallet_id       Int
  to_wallet_id         Int
  note                 String?
  transferred_at       DateTime @db.Timestamp(3)
  exclude_from_report  Boolean  @default(true)
  user_id              Int?
  house_id             Int?
  created_at           DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  from_wallet Wallet @relation("WalletTransferFrom", fields: [from_wallet_id], references: [id])
  to_wallet   Wallet @relation("WalletTransferTo", fields: [to_wallet_id], references: [id])
  user        User?  @relation(fields: [user_id], references: [id])
  house       House? @relation(fields: [house_id], references: [id])

  @@index([from_wallet_id])
  @@index([to_wallet_id])
  @@index([user_id])
  @@index([house_id])
  @@index([transferred_at])
}

model CreditCardPayment {
  id                    Int      @id @default(autoincrement())
  amount                Decimal  @db.Decimal(10, 2)
  paid_at               DateTime
  note                  String?
  credit_card_wallet_id Int
  source_wallet_id      Int?
  /// When false, payment is ledger-only (debt already adjusted at statement cutoff).
  adjusts_debt          Boolean  @default(true)
  user_id               Int?
  house_id              Int?
  expense_id            Int?     @unique
  created_at            DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  credit_card_wallet Wallet   @relation("CreditCardWalletPayments", fields: [credit_card_wallet_id], references: [id])
  source_wallet      Wallet?  @relation("CreditCardSourceWalletPayments", fields: [source_wallet_id], references: [id])
  user               User?    @relation(fields: [user_id], references: [id])
  house              House?   @relation(fields: [house_id], references: [id])
  expense            Expense? @relation(fields: [expense_id], references: [id], onDelete: SetNull)
  scheduled_payment       CreditCardScheduledPayment?
  installment_plan_payment CreditCardInstallmentPlanPayment?

  @@index([credit_card_wallet_id, paid_at])
  @@index([source_wallet_id, paid_at])
  @@index([user_id, paid_at])
  @@index([house_id, paid_at])
}

model Loan {
  id                 Int                  @id @default(autoincrement())
  name               String
  lender             String
  type               LoanType
  status             LoanStatus           @default(ACTIVE)
  principal_amount   Decimal              @db.Decimal(12, 2)
  payment_amount     Decimal              @db.Decimal(12, 2)
  payment_count      Int
  frequency          LoanPaymentFrequency
  start_date         DateTime
  payment_source     LoanPaymentSource
  user_id            Int?
  house_id           Int?
  source_wallet_id   Int?
  linked_wallet_id   Int?
  income_template_id Int?
  notes              String?
  created_at         DateTime             @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)
  updated_at         DateTime             @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  user            User?           @relation(fields: [user_id], references: [id])
  house           House?          @relation(fields: [house_id], references: [id])
  source_wallet   Wallet?         @relation("LoanPaymentSourceWallet", fields: [source_wallet_id], references: [id])
  linked_wallet   Wallet?         @relation("LoanLinkedWallet", fields: [linked_wallet_id], references: [id])
  income_template IncomeTemplate? @relation("LoanIncomeTemplate", fields: [income_template_id], references: [id])
  payments        LoanPayment[]

  @@index([user_id])
  @@index([house_id])
  @@index([status])
  @@index([source_wallet_id])
  @@index([linked_wallet_id])
  @@index([income_template_id])
}

model LoanPayment {
  id               Int               @id @default(autoincrement())
  loan_id          Int
  sequence         Int
  due_date         DateTime
  amount           Decimal           @db.Decimal(12, 2)
  status           LoanPaymentStatus @default(SCHEDULED)
  paid_at          DateTime?
  source_wallet_id Int?
  note             String?
  created_at       DateTime          @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)
  updated_at       DateTime          @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  loan           Loan     @relation(fields: [loan_id], references: [id], onDelete: Cascade)
  source_wallet  Wallet?  @relation("LoanPaymentSourceWallet", fields: [source_wallet_id], references: [id])
  linked_expense Expense? @relation("LoanPaymentExpense")

  @@unique([loan_id, sequence])
  @@index([loan_id])
  @@index([due_date])
  @@index([status])
  @@index([source_wallet_id])
}

/**
 * Uploaded issuer PDFs (per card). Parsed rows become Expense rows linked via statement_import_id.
 * Provider-specific parsers (e.g. Mercado Pago) live in server code.
 */
model CreditCardStatementImport {
  id                 Int                     @id @default(autoincrement())
  provider           StatementImportProvider
  wallet_id          Int
  user_id            Int?
  house_id           Int?
  created_by_user_id Int

  file_name String?
  file_mime String?
  file_data Bytes?

  period_start         DateTime?
  period_end           DateTime?
  account_number       String?
  statement_issue_date DateTime?
  payment_due_date     DateTime?
  total_due            Decimal?  @db.Decimal(12, 2)
  minimum_payment      Decimal?  @db.Decimal(12, 2)

  parse_warnings String[] @default([])

  created_at DateTime @default(dbgenerated("timezone('America/Mexico_City'::text, now())")) @db.Timestamp(3)

  wallet     Wallet    @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  user       User?     @relation("CreditCardStatementImportUserOwner", fields: [user_id], references: [id])
  house      House?    @relation("CreditCardStatementImportHouseOwner", fields: [house_id], references: [id])
  created_by User      @relation("CreditCardStatementImportCreatedBy", fields: [created_by_user_id], references: [id])
  expenses   Expense[]

  @@index([wallet_id])
  @@index([wallet_id, payment_due_date])
  @@index([user_id])
  @@index([user_id, payment_due_date])
  @@index([house_id])
  @@index([house_id, payment_due_date])
  @@index([created_at])
}
