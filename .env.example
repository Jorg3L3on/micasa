# PostgreSQL (required)
# Local default matches AGENTS.md / common Docker setups.
DATABASE_URL="postgresql://micasa:micasa123@localhost:5432/micasa"

# NextAuth (required)
NEXTAUTH_SECRET="replace-with-a-strong-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: bootstrap /admin access before User.is_admin is set in the DB
# MICASA_ADMIN_EMAILS="you@example.com"

# Optional: password hashed into seeded demo users (`npx prisma db seed`)
# SEED_PASSWORD="demo-password"

# Optional: distributed rate limiting in production (omit both for in-memory local limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
