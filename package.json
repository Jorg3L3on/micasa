{
  "name": "micasa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev": "next dev",
    "predev:webpack": "prisma generate",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:isolation": "vitest run --config vitest.isolation.config.ts",
    "backfill:fortnightly-loan-payments": "tsx --tsconfig tsconfig.json scripts/realign-fortnightly-loan-payments.ts",
    "realign:payday-fortnights": "tsx --tsconfig tsconfig.json scripts/realign-payday-fortnights.ts",
    "repair:card-payments": "tsx --tsconfig tsconfig.json scripts/repair-card-payment-inconsistencies.ts",
    "seed:categories": "tsx --tsconfig tsconfig.json scripts/seed-categories.ts",
    "validate:metric-strips": "node scripts/validate-metric-strips.mjs",
    "validate:calendar-dates": "node scripts/validate-calendar-dates.mjs",
    "validate:prisma-imports": "node scripts/validate-prisma-imports.mjs",
    "generate:brand-icons": "node scripts/generate-brand-icons.mjs",
    "generate:ios-splash": "node scripts/generate-ios-splash.mjs",
    "ci": "npm run validate:metric-strips && npm run validate:prisma-imports && npm run validate:calendar-dates && prisma generate && npm run test:coverage && npm run test:isolation && npm run build"
  },
  "dependencies": {
